# Environment template. Copy the backend block to `backend/.env` and the frontend block to
# `frontend/.env.local`, then fill in real values. NEVER commit the real files (both gitignored).
# See docs/runbooks/LOCAL-DEV.md (vars) and docs/runbooks/DEPLOY.md (provisioning + the two-DSN model).

# ─────────────────────────────────────────────────────────────────────────────
# backend/.env
# ─────────────────────────────────────────────────────────────────────────────

# Request-path DB connection — the least-privileged `app_user` role (RLS-enforced).
# On Supabase the pooler username looks like `app_user.<project-ref>`; use the session pooler
# (port 5432) — asyncpg + LOCAL `set_config` GUCs need it. Driver MUST be asyncpg.
# NEVER point this at a superuser/owner role, or Row-Level Security is bypassed.
DATABASE_URL=postgresql+asyncpg://app_user.<project-ref>:<password>@<pooler-host>:5432/postgres

# Admin DB connection — superuser/`postgres` role (BYPASSRLS). Used ONLY by Alembic migrations
# and the scheduler (which must see all tenants). Never use this for the request path.
ADMIN_DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres

# Supabase JWT verification — the backend verifies tokens itself (ES256 pinned) against the JWKS.
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_ISSUER=https://<project-ref>.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated

# Comma-separated allowed frontend origins. Moot under the same-origin /api proxy, but set to the
# real origin at the VPS domain (audit L3).
CORS_ORIGINS=http://localhost:3000

# External data providers (defaults are the public free tiers).
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
MFAPI_BASE_URL=https://api.mfapi.in/mf

# Background jobs (daily snapshot 23:55, monthly SIP on the 1st). Set false to disable.
SCHEDULER_ENABLED=true

# AI insights: `rules` (no external call, always works) or `gemini`.
AI_PROVIDER=rules
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ─────────────────────────────────────────────────────────────────────────────
# frontend/.env.local
# ─────────────────────────────────────────────────────────────────────────────

# MUST be /api — the same-origin proxy (next.config.ts `rewrites()`) forwards to the backend
# server-side. NEVER set localhost:8000 or a VM/VPS IP (the value is baked into the build).
NEXT_PUBLIC_API_BASE_URL=/api

# Supabase project for the browser auth client. Baked at build — rebuild the frontend after changing.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
