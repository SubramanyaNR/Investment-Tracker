# Copy this to .env and fill in your values.
# This file is read by docker-compose for variable substitution.

# The public URL of the backend, as seen by the browser.
# For local dev: http://localhost:8000
# For a VM/VPS: http://YOUR_VM_IP:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Comma-separated list of frontend origins the backend should accept.
# For local dev: http://localhost:3000
# For a VM/VPS: http://YOUR_VM_IP:3000,http://localhost:3000
CORS_ORIGINS=http://localhost:3000
