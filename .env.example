# Environment template.
#
# Docker Compose (recommended): copy this file to `.env` in the repo root, fill in the values
# below, then run `docker compose up -d --build`.
#
# Running backend/frontend directly instead (no Docker): copy the "backend" block into
# `backend/.env` and the "frontend" block into `frontend/.env.local`. See docs/runbooks/LOCAL-DEV.md.
#
# NEVER commit the real .env files (all gitignored).

# ─────────────────────────────────────────────────────────────────────────────
# Postgres (docker-compose.yml's postgres service)
# ─────────────────────────────────────────────────────────────────────────────
POSTGRES_USER=investment_admin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=investment_tracker

# ─────────────────────────────────────────────────────────────────────────────
# backend/.env
# ─────────────────────────────────────────────────────────────────────────────

# Single-user app, no Row-Level Security — both vars can point at the same database. Under Docker
# Compose these are set for you automatically; only fill them in if running the backend directly
# against docker-compose.yml's postgres service (localhost:5432) or your own Postgres.
DATABASE_URL=postgresql+asyncpg://investment_admin:change-me@localhost:5432/investment_tracker
ADMIN_DATABASE_URL=postgresql+asyncpg://investment_admin:change-me@localhost:5432/investment_tracker

# Empty disables TLS — required for a local/self-hosted Postgres without TLS configured.
DB_SSL=

# Comma-separated allowed frontend origins. Moot under the same-origin /api proxy; only matters if
# you expose the API directly.
CORS_ORIGINS=http://localhost:3000

# Auth. Generate a real secret: `openssl rand -hex 32`. ADMIN_EMAIL/ADMIN_PASSWORD bootstrap the
# single admin user on first run only (ignored afterward — run `make reset-admin-password` to
# change them later, see docs/runbooks/ADMIN-ACCOUNT-RECOVERY.md).
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=changeme

# Off by default: no login required, every request acts as the single admin user. Fine for a
# single local device only. Only enable if this instance is reachable by more than just you —
# and run `make reset-admin-password` first, since the ADMIN_PASSWORD above is a placeholder.
# A warning banner is always shown in the app whenever this is false.
AUTH_ENABLED=false

# Set true only once you're running behind real HTTPS (e.g. Tailscale, or your own TLS
# terminator). Plain HTTP (the out-of-the-box default) requires this to stay false, or the auth
# cookie won't be sent back by the browser.
COOKIE_SECURE=false

# External data providers (defaults are the public free tiers, no key required).
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
MFAPI_BASE_URL=https://api.mfapi.in/mf

# Background jobs (daily snapshot 23:55, monthly SIP on the 1st). Set false to disable.
SCHEDULER_ENABLED=true

# AI insights: `rules` (no external call, always works, default) or `gemini` (needs GEMINI_API_KEY).
AI_PROVIDER=rules
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ─────────────────────────────────────────────────────────────────────────────
# frontend/.env.local
# ─────────────────────────────────────────────────────────────────────────────

# MUST be /api — the same-origin proxy (next.config.ts `rewrites()`) forwards to the backend
# server-side. NEVER set localhost:8000 or a server IP (the value is baked into the build).
NEXT_PUBLIC_API_BASE_URL=/api
