[Unit]
Description=WealthSignal backend (uvicorn)
After=network-online.target docker.service
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=root
WorkingDirectory=/opt/Investment-Tracker/backend
EnvironmentFile=/opt/Investment-Tracker/backend/.env
ExecStart=/opt/Investment-Tracker/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
